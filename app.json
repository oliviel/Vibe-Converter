{
  "expo": {
    "name": "Vibe Converter",
    "slug": "Vibe-Converter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vibe-ai-converter-icon-green-highlight.png",
    "scheme": "vibeconverter",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/vibe-ai-converter-icon-green-highlight.png"
    },
    "android": {
      "package": "com.holiviel.vibeconverter",
      "adaptiveIcon": {
        "backgroundColor": "#063E16",
        "foregroundImage": "./assets/images/vibe-ai-converter-icon-green-highlight-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vibe-ai-converter-icon-green-highlight.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#063E16",
          "image": "./assets/images/vibe-ai-converter-icon-green-highlight.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc696e62-1a35-46bf-ad45-6122765590cd"
      }
    }
  }
}
